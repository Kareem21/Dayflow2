{
  "name": "dayflow-electron",
  "version": "1.0.0",
  "description": "Cross-platform screen activity tracker with AI-powered timeline",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "screen-recorder",
    "productivity",
    "timeline",
    "ai",
    "electron"
  ],
  "author": "Dayflow",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "fluent-ffmpeg": "^2.1.2",
    "node-fetch": "^3.3.2",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.dayflow.app",
    "productName": "Dayflow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
